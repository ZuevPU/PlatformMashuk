# Подключение к PostgreSQL.
#
# Без базы открывается только витрина на демонстрационных данных из src/lib/mock.
# Вход, рабочее пространство (канал, чаты, опросы) и админка работают с базой.
#
# Чтобы включить настоящую базу, скопируйте этот файл в .env.local
# и раскомментируйте строку ниже.

# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mashuk_platform

# Локальная проверка production-сборки по http:// (npm run build + npm run start).
# В рабочей версии cookie сессии отдаётся только по HTTPS, поэтому для проверки
# на своём компьютере по http:// этот флаг нужно включить.
# ALLOW_INSECURE_COOKIES=1

# Размер пула соединений с базой (по умолчанию 20). Держите ниже max_connections
# Postgres (по умолчанию 100) с запасом на миграции и бэкапы.
# DB_POOL_MAX=20

# Секрет для обезличенных ключей ответов в опросах (в рабочей версии обязателен).
# AUTH_SECRET=

# Где хранить фото и сборки программ (по умолчанию ./storage).
# STORAGE_DIR=./storage

# Или S3-совместимое хранилище (Yandex Object Storage, Selectel, VK Cloud, MinIO):
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Пароли для npm run db:seed. Если не заданы — генерируются и пишутся
# в storage/seed-credentials.txt.
# SEED_ADMIN_PASSWORD=
# SEED_PROGRAM_PASSWORD=
# SEED_DEMO_PASSWORD=
