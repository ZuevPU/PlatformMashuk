# Подключение к PostgreSQL.
#
# Пока переменная не задана, платформа работает на демонстрационных данных
# из src/lib/mock — запуск не требует базы.
#
# Чтобы включить настоящую базу, скопируйте этот файл в .env.local
# и раскомментируйте строку ниже.

# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mashuk_platform

# Локальная проверка production-сборки по http:// (npm run build + npm run start).
# В рабочей версии cookie сессии отдаётся только по HTTPS, поэтому для проверки
# на своём компьютере по http:// этот флаг нужно включить.
# ALLOW_INSECURE_COOKIES=1
